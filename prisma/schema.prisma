generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuarios {
  id                  Int                   @id @default(autoincrement())
  nome                String
  email               String                @unique
  senha_hash          String
  criado_em           DateTime              @default(now())

  movimentacoes       Movimentacoes[]
  categorias          Categorias[]
  orcamentos          Orcamentos[]
  metas               Metas[]
  caixas              Caixas[]
  movimentacoesCaixas MovimentacoesCaixas[]
}

model Categorias {
  id             Int             @id @default(autoincrement())
  nome           String
  tipo           String
  criado_em      DateTime        @default(now())

  usuarioId      Int
  usuario        Usuarios        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  movimentacoes  Movimentacoes[]
  orcamentos     Orcamentos[]

  caixaId        Int?
  caixa          Caixas?         @relation(fields: [caixaId], references: [id], onDelete: SetNull)

  @@unique([nome, tipo, usuarioId])
  @@index([usuarioId])
  @@index([caixaId])
}

model Movimentacoes {
  id             Int             @id @default(autoincrement())
  descricao      String
  valor          Float
  tipo           String
  categoria      String
  data           DateTime        @default(now())
  criado_em      DateTime        @default(now())

  usuarioId      Int
  usuario        Usuarios        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId    Int?
  categoriaRef   Categorias?     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([categoriaId])
}

model Orcamentos {
  id          Int        @id @default(autoincrement())
  limite      Float
  mes         Int
  ano         Int
  criado_em   DateTime   @default(now())

  usuarioId   Int
  usuario     Usuarios   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId Int
  categoria   Categorias @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@unique([categoriaId, mes, ano, usuarioId])
  @@index([usuarioId])
  @@index([categoriaId])
}

model Metas {
  id          Int       @id @default(autoincrement())
  titulo      String
  tipo        String
  valorAlvo   Float
  dataInicio  DateTime
  dataFim     DateTime
  criadaEm    DateTime  @default(now())

  usuarioId   Int
  usuario     Usuarios  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Caixas {
  id            Int                   @id @default(autoincrement())
  nome          String
  tipo          String
  limiteMensal  Float?
  criado_em     DateTime              @default(now())

  usuarioId     Int
  usuario       Usuarios              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categorias    Categorias[]
  movimentacoes MovimentacoesCaixas[]

  @@unique([nome, usuarioId])
  @@index([usuarioId])
}

model MovimentacoesCaixas {
  id        Int      @id @default(autoincrement())
  tipo      String
  valor     Float
  descricao String?
  data      DateTime @default(now())
  criado_em DateTime @default(now())

  usuarioId Int
  usuario   Usuarios @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  caixaId   Int
  caixa     Caixas   @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([caixaId])
}
