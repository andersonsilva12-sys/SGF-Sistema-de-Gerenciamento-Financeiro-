generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuarios {
  id             Int             @id @default(autoincrement())
  nome           String
  email          String          @unique
  senha_hash     String
  criado_em      DateTime        @default(now())

  movimentacoes  Movimentacoes[]
  categorias     Categorias[]
  orcamentos     Orcamentos[]
}

model Categorias {
  id             Int             @id @default(autoincrement())
  nome           String
  tipo           String
  criado_em      DateTime        @default(now())

  usuarioId      Int
  usuario        Usuarios        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  movimentacoes  Movimentacoes[]
  orcamentos      Orcamentos[]

  @@unique([nome, tipo, usuarioId])
  @@index([usuarioId])
}

model Movimentacoes {
  id             Int             @id @default(autoincrement())
  descricao      String
  valor          Float
  tipo           String
  categoria      String
  data           DateTime        @default(now())
  criado_em      DateTime        @default(now())

  usuarioId      Int
  usuario        Usuarios        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId    Int?
  categoriaRef   Categorias?     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([categoriaId])
}


model Orcamentos {
  id          Int        @id @default(autoincrement())
  limite      Float
  mes         Int
  ano         Int
  criado_em   DateTime   @default(now())

  usuarioId   Int
  usuario     Usuarios   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId Int
  categoria   Categorias @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@unique([categoriaId, mes, ano, usuarioId])
  @@index([usuarioId])
  @@index([categoriaId])
}
